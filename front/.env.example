# Plantilla de variables del frontend. Copie este archivo según el ambiente:
#   desarrollo  → .env.development.local (opcional: Vite redirige /api a localhost:3000)
#   staging     → .env.staging.local     (npm run build:staging)
#   producción  → .env.production.local  (npm run build)
#
# Todo lo que empieza con VITE_ queda visible en el navegador.
# Nunca coloque aquí contraseñas, JWT_ACCESS_SECRET ni claves service_role de Supabase;
# el build se detiene si detecta una variable VITE_ con nombre de secreto.
VITE_API_URL=/api
